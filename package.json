{
  "name": "dmarc-shield",
  "version": "0.1.0",
  "private": true,
  "description": "Outlook add-in that shows DMARC, SPF and DKIM authentication status, entirely client-side.",
  "license": "MIT",
  "author": "Bernd Verhofstadt",
  "repository": {
    "type": "git",
    "url": "https://github.com/berndverhofstadt/dmarc-shield.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/office-js": "^1.0.614",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
